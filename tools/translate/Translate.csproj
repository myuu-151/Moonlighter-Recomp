<Project Sdk="Microsoft.NET.Sdk">
  <!-- tools/translate: the C# -> C++ translator for the game's code (docs/translator_plan.md).
       Run: dotnet run -c Release (project tools/translate), arguments survey or translate. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MoonlighterTranslate</RootNamespace>
    <AssemblyName>mltranslate</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="10.1.1.8388" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
</Project>
